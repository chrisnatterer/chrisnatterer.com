---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InstagramFeed from "../../components/InstagramFeed.astro";
import { getCollection } from "astro:content";

const articles = (await getCollection("articles"))
  .filter((a) => !a.data.draft && a.data.lang === "de")
  .sort((a, b) => +new Date(b.data.publishDate) - +new Date(a.data.publishDate))
  .slice(0, 3);
---
<BaseLayout
  title="Chris Natterer — Systemdenker & Builder"
  description="Ich durchschaue Systeme, damit du es nicht musst. KI-Tools, Produktivität, internationales Leben und Business-Abläufe, einfach erklärt."
  lang="de"
  altUrl="/"
>
  <!-- Hero -->
  <section class="min-h-[85vh] flex items-center pt-20">
    <div class="max-w-5xl mx-auto px-6 py-20">
      <p class="font-mono text-orange text-sm tracking-wider uppercase mb-6 fade-in">Chris Natterer</p>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-off-white leading-[1.1] mb-6 fade-in fade-in-delay-1">
        Ich durchschaue Systeme,<br />
        <span class="accent-underline">damit du es nicht musst.</span>
      </h1>
      <p class="text-lg sm:text-xl text-light-stone max-w-2xl mb-10 leading-relaxed fade-in fade-in-delay-2">
        KI-Tools. Produktivitätssysteme. Internationales Leben. Business-Abläufe.<br />
        Ich gehe in die Tiefe, filtere das Rauschen, und teile, was wirklich funktioniert.
      </p>
      <div class="flex flex-wrap gap-4 fade-in fade-in-delay-3">
        <a href="#newsletter" class="inline-flex items-center gap-2 bg-orange hover:bg-orange-bright text-off-white font-semibold px-6 py-3 rounded-md transition-colors">
          Newsletter holen
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </a>
        <a href="/de/artikel" class="inline-flex items-center gap-2 border border-border hover:border-stone/40 text-light-stone px-6 py-3 rounded-md transition-colors">
          Artikel lesen
        </a>
      </div>
    </div>
  </section>

  <!-- Über mich -->
  <section id="about" class="py-24">
    <div class="max-w-5xl mx-auto px-6">
      <div class="grid md:grid-cols-[1fr_2fr] gap-12 items-start">
        <div class="relative">
          <div class="aspect-[3/4] rounded-lg bg-charcoal border border-border overflow-hidden">
            <img src="/images/chris-natterer.webp" alt="Chris Natterer" class="w-full h-full object-cover object-top" width="512" height="512" />
          </div>
          <div class="absolute -bottom-3 -right-3 bg-orange text-off-white font-mono text-xs px-3 py-1.5 rounded">Systemdenker</div>
        </div>

        <div>
          <h2 class="font-mono text-orange text-sm tracking-wider uppercase mb-4">Über mich</h2>
          <h3 class="text-2xl sm:text-3xl font-bold text-off-white mb-6">Die Kurzfassung</h3>
          <div class="space-y-4 text-light-stone leading-relaxed">
            <p>Ich bin ein Systemdenker. Ich greife Dinge früh auf, durchschaue, wie sie wirklich funktionieren, und erkläre sie Leuten, die keine Zeit haben, sich selbst durchzuarbeiten.</p>
            <p>Ich habe auf drei Kontinenten gelebt, Geschäfte über Grenzen hinweg aufgebaut und das letzte Jahrzehnt damit verbracht, tief in alles einzutauchen, von KI-Workflows über persönliche Finanzen bis zu internationaler Steuerstrategie.</p>
            <p>Ich bin kein Guru, der einen Lifestyle verkauft. Ich bin der, der es schon getestet hat, das Rauschen rausgefiltert hat und dir die Lernkurve abnimmt.</p>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mt-8">
            <div class="bg-charcoal border border-border rounded-md p-4">
              <p class="text-orange font-mono text-sm mb-1">Aktuell in</p>
              <p class="text-off-white font-medium">Tiflis, Georgien</p>
            </div>
            <div class="bg-charcoal border border-border rounded-md p-4">
              <p class="text-orange font-mono text-sm mb-1">Kontinente</p>
              <p class="text-off-white font-medium">3 und es werden mehr</p>
            </div>
            <div class="bg-charcoal border border-border rounded-md p-4">
              <p class="text-orange font-mono text-sm mb-1">BJJ</p>
              <p class="text-off-white font-medium">Brauner Gürtel</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Worüber ich schreibe -->
  <section class="py-24 border-t border-border">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="font-mono text-orange text-sm tracking-wider uppercase mb-4">Worüber ich schreibe</h2>
      <h3 class="text-2xl sm:text-3xl font-bold text-off-white mb-12">Themen, in die ich tief eintauche</h3>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="bg-charcoal border border-border rounded-lg p-6 hover:border-orange/30 transition-colors group">
          <div class="w-10 h-10 rounded-md bg-orange-glow flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </div>
          <h4 class="text-off-white font-semibold text-lg mb-2">KI & Tools</h4>
          <p class="text-stone text-sm leading-relaxed">Wie man KI und moderne Tools wirklich effektiv einsetzt. Prompting-Strategien, echte Workflows, ehrliche Einschätzungen.</p>
        </div>

        <div class="bg-charcoal border border-border rounded-lg p-6 hover:border-orange/30 transition-colors group">
          <div class="w-10 h-10 rounded-md bg-orange-glow flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
          </div>
          <h4 class="text-off-white font-semibold text-lg mb-2">Produktivitätssysteme</h4>
          <p class="text-stone text-sm leading-relaxed">Workflows, Tools und Setups, die Reibung rausnehmen. Systeme, die hängen bleiben, nicht nur auf Screenshots gut aussehen.</p>
        </div>

        <div class="bg-charcoal border border-border rounded-lg p-6 hover:border-orange/30 transition-colors group">
          <div class="w-10 h-10 rounded-md bg-orange-glow flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h4 class="text-off-white font-semibold text-lg mb-2">Internationales Leben</h4>
          <p class="text-stone text-sm leading-relaxed">Ein Leben und Geschäft über Grenzen hinweg aufbauen. Banking, Steuern, Aufenthalt und die praktische Logistik, über die niemand spricht.</p>
        </div>

        <div class="bg-charcoal border border-border rounded-lg p-6 hover:border-orange/30 transition-colors group">
          <div class="w-10 h-10 rounded-md bg-orange-glow flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
          </div>
          <h4 class="text-off-white font-semibold text-lg mb-2">Einfache Finanzen</h4>
          <p class="text-stone text-sm leading-relaxed">Persönliche Finanzen und Investieren ohne den Ballast. Index-Fonds, internationales Banking, typische Fehler vermeiden.</p>
        </div>

        <div class="bg-charcoal border border-border rounded-lg p-6 hover:border-orange/30 transition-colors group">
          <div class="w-10 h-10 rounded-md bg-orange-glow flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <h4 class="text-off-white font-semibold text-lg mb-2">Business-Abläufe</h4>
          <p class="text-stone text-sm leading-relaxed">Mit Systemen ein Geschäft effizient führen. KI im Business, Automatisierung und Prozesse, die ohne mehr Personal skalieren.</p>
        </div>
      </div>
    </div>
  </section>

  {articles.length > 0 && (
    <section class="py-24 border-t border-border">
      <div class="max-w-5xl mx-auto px-6">
        <div class="flex items-end justify-between mb-12">
          <div>
            <h2 class="font-mono text-orange text-sm tracking-wider uppercase mb-4">Artikel</h2>
            <h3 class="text-2xl sm:text-3xl font-bold text-off-white">Zuletzt geschrieben</h3>
          </div>
          <a href="/de/artikel" class="text-stone hover:text-orange transition-colors text-sm whitespace-nowrap">Alle &rarr;</a>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
          {articles.map((a) => (
            <a href={`/${a.id}`} class="group bg-charcoal border border-border rounded-lg overflow-hidden hover:border-orange/30 transition-all">
              {a.data.featuredImage && (
                <img src={a.data.featuredImage} alt={a.data.featuredImageAlt ?? a.data.title} class="w-full aspect-[16/9] object-cover" loading="lazy" />
              )}
              <div class="p-6">
                {a.data.label && <p class="font-mono text-orange text-xs tracking-wider uppercase mb-2">{a.data.label}</p>}
                <h4 class="text-off-white font-semibold text-lg mb-2 group-hover:text-orange transition-colors">{a.data.title}</h4>
                <p class="text-stone text-sm leading-relaxed line-clamp-3">{a.data.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Projekte -->
  <section id="projects" class="py-24 border-t border-border">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="font-mono text-orange text-sm tracking-wider uppercase mb-4">Aktuelle Projekte</h2>
      <h3 class="text-2xl sm:text-3xl font-bold text-off-white mb-12">Woran ich baue</h3>

      <div class="grid md:grid-cols-2 gap-6">
        <a href="https://globalizationguide.com" target="_blank" rel="noopener" class="group bg-charcoal border border-border rounded-lg p-8 hover:border-orange/30 transition-all">
          <div class="flex items-start justify-between mb-4">
            <div>
              <h4 class="text-off-white font-semibold text-xl mb-1 group-hover:text-orange transition-colors">Globalization Guide</h4>
              <p class="text-orange font-mono text-xs">globalizationguide.com</p>
            </div>
            <svg class="w-5 h-5 text-stone group-hover:text-orange transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </div>
          <p class="text-stone leading-relaxed">US-LLC-Gründung, EIN-Anträge und Form-5472-Compliance für internationale Gründer. Hilft Nicht-Ansässigen, sich in der amerikanischen Unternehmensstruktur zurechtzufinden.</p>
          <div class="flex gap-2 mt-4">
            <span class="text-xs font-mono bg-orange-glow text-orange px-2 py-1 rounded">LLC-Gründung</span>
            <span class="text-xs font-mono bg-orange-glow text-orange px-2 py-1 rounded">Steuer-Compliance</span>
            <span class="text-xs font-mono bg-orange-glow text-orange px-2 py-1 rounded">EIN</span>
          </div>
        </a>

        <a href="/apartment" class="group bg-charcoal border border-border rounded-lg p-8 hover:border-orange/30 transition-all">
          <div class="flex items-start justify-between mb-4">
            <div>
              <h4 class="text-off-white font-semibold text-xl mb-1 group-hover:text-orange transition-colors">Apartment in Tiflis</h4>
              <p class="text-orange font-mono text-xs">Duplex zu vermieten — Vera-Viertel</p>
            </div>
            <svg class="w-5 h-5 text-stone group-hover:text-orange transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </div>
          <p class="text-stone leading-relaxed">200 m² Duplex in der Kostava-Straße. 3 Schlafzimmer, Büro mit Stehpulten, private Terrasse, Smart Home. Voll möbliert und bezugsfertig.</p>
          <div class="flex gap-2 mt-4">
            <span class="text-xs font-mono bg-orange-glow text-orange px-2 py-1 rounded">Vera-Viertel</span>
            <span class="text-xs font-mono bg-orange-glow text-orange px-2 py-1 rounded">Smart Home</span>
            <span class="text-xs font-mono bg-orange-glow text-orange px-2 py-1 rounded">1.250 $/Monat</span>
          </div>
        </a>

        <a href="#" class="group bg-charcoal border border-border rounded-lg p-8 hover:border-orange/30 transition-all relative overflow-hidden">
          <div class="absolute top-4 right-4">
            <span class="text-xs font-mono bg-orange/20 text-orange px-2 py-1 rounded">Bald</span>
          </div>
          <div class="mb-4">
            <h4 class="text-off-white font-semibold text-xl mb-1">YouTube-Kanal</h4>
            <p class="text-orange font-mono text-xs">Content rund um Systeme</p>
          </div>
          <p class="text-stone leading-relaxed">Lerninhalte zu KI-Tools, Produktivitätssystemen und dem Aufbau eines internationalen Lebens. Tiefgang und ehrliche Einschätzungen, kein Hype.</p>
          <div class="flex gap-2 mt-4">
            <span class="text-xs font-mono bg-orange-glow text-orange px-2 py-1 rounded">KI-Tutorials</span>
            <span class="text-xs font-mono bg-orange-glow text-orange px-2 py-1 rounded">Produktivität</span>
            <span class="text-xs font-mono bg-orange-glow text-orange px-2 py-1 rounded">International</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <InstagramFeed lang="de" />

  <!-- Newsletter -->
  <section id="newsletter" class="py-24 border-t border-border">
    <div class="max-w-2xl mx-auto px-6 text-center">
      <h2 class="font-mono text-orange text-sm tracking-wider uppercase mb-4">Newsletter</h2>
      <h3 class="text-2xl sm:text-3xl font-bold text-off-white mb-4">Das Signal, ohne das Rauschen</h3>
      <p class="text-light-stone mb-8 leading-relaxed">Ich teile, was ich über KI, Produktivität und internationales Leben lerne. Praktisches Zeug. Kein Spam, kein Füllmaterial, jederzeit abbestellbar.</p>

      <form id="newsletter-form" class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto" onsubmit="event.preventDefault(); document.getElementById('form-message').classList.remove('hidden');">
        <input type="email" placeholder="deine@email.com" required class="flex-1 bg-charcoal border border-border rounded-md px-4 py-3 text-off-white placeholder:text-stone/50 focus:outline-none focus:border-orange transition-colors" />
        <button type="submit" class="bg-orange hover:bg-orange-bright text-off-white font-semibold px-6 py-3 rounded-md transition-colors whitespace-nowrap">Abonnieren</button>
      </form>
      <p id="form-message" class="hidden text-orange text-sm mt-4">Newsletter kommt bald. Danke für dein Interesse!</p>
    </div>
  </section>
</BaseLayout>
