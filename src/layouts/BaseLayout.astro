---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  lang?: "en" | "de";
  ogType?: string;
  ogImage?: string;
  /** Equivalent page in the other language, e.g. "/de/" on the EN home. Enables
   *  the nav switcher target and reciprocal hreflang tags. */
  altUrl?: string;
  /** Hide from search engines (e.g. design studies). */
  noindex?: boolean;
}

const {
  title,
  description = "I figure out systems so you don't have to. AI tools, productivity, international life, and business operations, simplified.",
  lang = "en",
  ogType = "website",
  ogImage,
  altUrl,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const altHref = altUrl ? new URL(altUrl, Astro.site).href : null;
const otherLang = lang === "de" ? "en" : "de";
---
<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site).href} />}
  {noindex && <meta name="robots" content="noindex" />}
  {altHref && <link rel="alternate" hreflang={lang} href={canonical} />}
  {altHref && <link rel="alternate" hreflang={otherLang} href={altHref} />}
  {altHref && <link rel="alternate" hreflang="x-default" href={lang === "en" ? canonical : altHref} />}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />
</head>
<body class="bg-black text-stone font-sans antialiased">
  <Nav lang={lang} altUrl={altUrl} />
  <slot />
  <Footer />
</body>
</html>
