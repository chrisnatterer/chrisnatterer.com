---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { getAlternates, abs, SITE_URL } from "../config/hreflang";

interface Props {
  title: string;
  description?: string;
  lang?: "en" | "de";
  ogType?: string;
  ogImage?: string;
  /** Equivalent page in the other language, e.g. "/de/" on the EN home. Enables
   *  the nav switcher target and reciprocal hreflang tags. */
  altUrl?: string;
  /** Hide from search engines (e.g. design studies). */
  noindex?: boolean;
}

const {
  title,
  description = "I figure out systems so you don't have to. AI tools, productivity, international life, and business operations, simplified.",
  lang = "en",
  ogType = "website",
  ogImage,
  altUrl,
  noindex = false,
} = Astro.props;

const canonical = abs(Astro.url.pathname, SITE_URL);
const otherLang = lang === "de" ? "en" : "de";

// hreflang: the central registry owns structural pages (home, listings) and
// returns the complete reciprocal set. Pages not in a group (articles) fall back
// to a set built from their `altUrl` frontmatter. Pages with neither emit none.
const altFallback = altUrl
  ? [
      { hreflang: lang, href: canonical },
      { hreflang: otherLang, href: abs(altUrl, SITE_URL) },
      { hreflang: "x-default", href: lang === "en" ? canonical : abs(altUrl, SITE_URL) },
    ]
  : undefined;
const finalAlternates = getAlternates(Astro.url.pathname, SITE_URL) ?? altFallback;
---
<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site).href} />}
  {noindex && <meta name="robots" content="noindex" />}
  {finalAlternates && finalAlternates.map((alt) => (
    <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
  ))}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />
</head>
<body class="bg-black text-stone font-sans antialiased">
  <Nav lang={lang} altUrl={altUrl} />
  <slot />
  <Footer />
</body>
</html>
